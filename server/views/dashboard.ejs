<!DOCTYPE html>
<html lang="pt-br" data-site-theme="mono" data-mode="dark">
<head>
  <%- include('partials/head') %>
  <title>Painel — Direcionador</title>
</head>
<body class="app-shell">
  <header class="app-nav">
    <a class="brand" href="/">Direcionador</a>
    <nav>
      <a class="btn btn-ghost" href="/u/<%= user.username %>" target="_blank" rel="noopener">Ver minha página</a>
      <form method="POST" action="/logout" style="display:inline">
        <button class="btn btn-ghost" type="submit">Sair</button>
      </form>
    </nav>
  </header>

  <div class="editor-layout">
    <main class="dashboard">
      <% if (message) { %><p class="flash"><%= message %></p><% } %>

      <section class="panel">
        <h2>Perfil</h2>
        <form method="POST" action="/dashboard/profile">
          <label>Nome
            <input type="text" name="display_name" value="<%= user.display_name %>" maxlength="60">
          </label>
          <label>Bio
            <input type="text" name="bio" value="<%= user.bio %>" maxlength="140">
          </label>
          <button class="btn btn-solid" type="submit">Salvar perfil</button>
        </form>
        <p class="hint">Sua página: <a href="/u/<%= user.username %>" target="_blank" rel="noopener">/u/<%= user.username %></a>
          · Plano: <strong><%= user.plan === "pro" ? "PRO" : "Grátis" %></strong></p>
      </section>

      <section class="panel">
        <h2>Links</h2>
        <ul class="card-list">
          <% links.forEach((link, i) => { %>
            <li class="item-card">
              <form method="POST" action="/dashboard/links/<%= link.id %>" class="item-card-edit">
                <div class="item-card-head">
                  <span class="item-badge"><%- icons[link.icon] || icons.link %></span>
                  <select name="icon">
                    <option value="link" <%= link.icon === "link" ? "selected" : "" %>>Genérico</option>
                    <option value="whatsapp" <%= link.icon === "whatsapp" ? "selected" : "" %>>WhatsApp</option>
                    <option value="briefcase" <%= link.icon === "briefcase" ? "selected" : "" %>>Portfólio</option>
                    <option value="cart" <%= link.icon === "cart" ? "selected" : "" %>>Loja</option>
                  </select>
                  <input type="text" name="label" value="<%= link.label %>" maxlength="40" placeholder="Nome do link">
                </div>
                <input type="url" name="url" value="<%= link.url %>" placeholder="https://...">
                <button class="btn btn-solid" type="submit">Salvar</button>
              </form>
              <div class="item-card-toolbar">
                <form method="POST" action="/dashboard/links/<%= link.id %>/move">
                  <input type="hidden" name="direction" value="up">
                  <button class="btn" type="submit" title="Mover pra cima" <%= i === 0 ? "disabled" : "" %>>&uarr;</button>
                </form>
                <form method="POST" action="/dashboard/links/<%= link.id %>/move">
                  <input type="hidden" name="direction" value="down">
                  <button class="btn" type="submit" title="Mover pra baixo" <%= i === links.length - 1 ? "disabled" : "" %>>&darr;</button>
                </form>
                <form method="POST" action="/dashboard/links/<%= link.id %>/featured">
                  <button class="btn" type="submit"><%= link.featured ? "★ Destacado" : "☆ Destacar" %></button>
                </form>
                <form method="POST" action="/dashboard/links/<%= link.id %>/delete">
                  <button class="btn btn-danger" type="submit">Remover</button>
                </form>
              </div>
            </li>
          <% }) %>
          <% if (!links.length) { %><li class="edit-empty">Nenhum link ainda.</li><% } %>
        </ul>

        <details class="add-item">
          <summary class="btn btn-solid btn-lg">+ Adicionar link</summary>
          <form method="POST" action="/dashboard/links" class="inline-form">
            <input type="text" name="label" placeholder="Nome do link" required maxlength="40">
            <input type="url" name="url" placeholder="https://..." required>
            <select name="icon">
              <option value="link">Genérico</option>
              <option value="whatsapp">WhatsApp</option>
              <option value="briefcase">Portfólio</option>
              <option value="cart">Loja</option>
            </select>
            <button class="btn btn-solid" type="submit">Adicionar</button>
          </form>
        </details>
      </section>

      <section class="panel">
        <h2>Redes sociais</h2>
        <ul class="card-list">
          <% socials.forEach(social => { %>
            <li class="item-card">
              <form method="POST" action="/dashboard/socials/<%= social.id %>" class="item-card-edit">
                <div class="item-card-head">
                  <span class="item-badge"><%- icons[social.icon] || icons.link %></span>
                  <select name="icon">
                    <option value="instagram" <%= social.icon === "instagram" ? "selected" : "" %>>Instagram</option>
                    <option value="github" <%= social.icon === "github" ? "selected" : "" %>>GitHub</option>
                    <option value="linkedin" <%= social.icon === "linkedin" ? "selected" : "" %>>LinkedIn</option>
                    <option value="youtube" <%= social.icon === "youtube" ? "selected" : "" %>>YouTube</option>
                  </select>
                </div>
                <input type="url" name="url" value="<%= social.url %>" placeholder="https://...">
                <button class="btn btn-solid" type="submit">Salvar</button>
              </form>
              <div class="item-card-toolbar">
                <form method="POST" action="/dashboard/socials/<%= social.id %>/delete">
                  <button class="btn btn-danger" type="submit">Remover</button>
                </form>
              </div>
            </li>
          <% }) %>
          <% if (!socials.length) { %><li class="edit-empty">Nenhuma rede social ainda.</li><% } %>
        </ul>

        <details class="add-item">
          <summary class="btn btn-solid btn-lg">+ Adicionar rede</summary>
          <form method="POST" action="/dashboard/socials" class="inline-form">
            <select name="icon">
              <option value="instagram">Instagram</option>
              <option value="github">GitHub</option>
              <option value="linkedin">LinkedIn</option>
              <option value="youtube">YouTube</option>
            </select>
            <input type="url" name="url" placeholder="https://..." required>
            <button class="btn btn-solid" type="submit">Adicionar</button>
          </form>
        </details>
      </section>

      <section class="panel">
        <h2>Tema</h2>
        <div class="theme-grid">
          <% Object.entries(themes).forEach(([key, def]) => { %>
            <form method="POST" action="/dashboard/theme" class="theme-card <%= user.theme === key ? 'theme-card--active' : '' %>">
              <input type="hidden" name="theme" value="<%= key %>">
              <div class="theme-swatch" data-site-theme="<%= key %>">
                <div class="theme-swatch-avatar"></div>
                <div class="theme-swatch-name"></div>
                <div class="theme-swatch-btn theme-swatch-btn--featured"></div>
                <div class="theme-swatch-btn"></div>
              </div>
              <span><%= def.name %></span>
              <% if (!def.free && user.plan !== "pro") { %>
                <span class="lock-badge">🔒 PRO</span>
                <button class="btn" type="submit" disabled>Bloqueado</button>
              <% } else { %>
                <button class="btn" type="submit"><%= user.theme === key ? "Selecionado" : "Usar este" %></button>
              <% } %>
            </form>
          <% }) %>
        </div>
      </section>
    </main>

    <aside class="preview-pane">
      <div class="preview-pane-inner">
        <p class="preview-label">Pré-visualização</p>
        <div class="phone-frame">
          <div class="phone-notch"></div>
          <iframe src="/u/<%= user.username %>" title="Pré-visualização da sua página"></iframe>
        </div>
      </div>
    </aside>
  </div>
</body>
</html>
